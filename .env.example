# Copy this file to .env and fill in your key. .env is never uploaded to GitHub.
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Run `python src/check_api.py` to see which Flash models your key can use
GEMINI_MODEL=gemini-3.5-flash-lite
# If the main model is busy (HTTP 503), these are tried in order
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash

# Optional backup (cheap, prepaid): https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Free tier is rate limited; keep this low
REQUESTS_PER_MINUTE=14
BATCH_SIZE=20
